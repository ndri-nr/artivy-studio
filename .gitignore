# The projects are independent repos with their own remotes, cloned here by
# bootstrap.sh. They are NOT submodules and must not be tracked: git would
# otherwise record each one as a half-made gitlink, which is the confusion this
# workspace is arranged to avoid. See README.md.
/wordle/
/pawdoku/
/stacko/
/2048/
/artivy/
/ndri-nr.github.io/
/rekta/
/pourfect/
/game-center/
/artivy-p2p-engine/
/adledger/

# Shared generated build artifacts configured by workspace-env.sh. Dependency
# downloads remain in the standard per-user caches so other workspaces reuse them.
/.cache/

# Release artifacts, collected here by hand after every build so there is one
# place to look instead of six build/ trees. Never tracked: they are large,
# regenerable, and signed — a keystore-signed binary has no business in a repo.
/builds/

.DS_Store
